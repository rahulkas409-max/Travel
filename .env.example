# ───────────────────────── RoamIndia — money settings ─────────────────────────
# Copy to .env.local for local dev, or add in Vercel → Project → Settings →
# Environment Variables. Everything is optional: missing values fall back safely.

# Public (shown in the browser)
NEXT_PUBLIC_BUSINESS_NAME=RoamIndia
NEXT_PUBLIC_SITE_URL=https://travel-delta-nine-17.vercel.app
NEXT_PUBLIC_CONTACT_WHATSAPP=919876543210        # your WhatsApp Business number, no "+"
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_UPI_ID=yourname@okhdfcbank            # direct UPI payments (0% fee)
NEXT_PUBLIC_UPI_NAME=RoamIndia
NEXT_PUBLIC_GSTIN=                                # add once registered

# Affiliate IDs (earn commission on bookings; traveller pays the same price)
NEXT_PUBLIC_BOOKING_AID=                          # Booking.com Affiliate Partner ID
NEXT_PUBLIC_GYG_PARTNER_ID=                       # GetYourGuide partner ID
NEXT_PUBLIC_KLOOK_AID=                            # Klook affiliate ID

# Optional Razorpay Payment Links (cards + UPI + netbanking). Without them, UPI is used.
NEXT_PUBLIC_RZP_LINK_PRO_TRIP=
NEXT_PUBLIC_RZP_LINK_PRO_YEAR=
NEXT_PUBLIC_RZP_LINK_VERIFIED=
NEXT_PUBLIC_RZP_LINK_FEATURED=
NEXT_PUBLIC_RZP_LINK_LEAD=
NEXT_PUBLIC_RZP_LINK_SUPPORT=

# Server-only secrets (never prefixed with NEXT_PUBLIC_)
ENQUIRY_WEBHOOK_URL=      # POST JSON for every enquiry/listing (Google Apps Script, Zapier, Make, Slack…)
SUPABASE_URL=             # optional: store enquiries in a Supabase table named "enquiries"
SUPABASE_SERVICE_KEY=
PRO_SECRET=               # long random string used to sign Pro access codes
ADMIN_PASSWORD=           # protects /admin (issue Pro codes, check setup)
